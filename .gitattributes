# Zeilenenden automatisch normalisieren
* text=auto

# ─── Unity-YAML (Text, damit Git Änderungen anzeigen kann) ───
*.unity               text
*.prefab              text
*.asset               text
*.meta                text
*.mat                 text
*.anim                text
*.controller          text
*.overrideController  text
*.mask                text
*.physicMaterial      text
*.physicsMaterial     text
*.playable            text
*.lighting            text
*.shadergraph         text
*.shadersubgraph      text
*.vfx                 text
*.inputactions        text

# ─── Code ───
*.cs      text diff=csharp
*.py      text diff=python
*.shader  text
*.hlsl    text
*.cginc   text
*.json    text
*.md      text

# ─── Git LFS: große Binärdateien ───
# Voraussetzung: einmalig "git lfs install" ausführen.

# 3D
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.obj     filter=lfs diff=lfs merge=lfs -text
*.glb     filter=lfs diff=lfs merge=lfs -text
*.blend   filter=lfs diff=lfs merge=lfs -text

# Bilder
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.tif     filter=lfs diff=lfs merge=lfs -text
*.tiff    filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text

# Audio
*.wav     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.aif     filter=lfs diff=lfs merge=lfs -text
*.aiff    filter=lfs diff=lfs merge=lfs -text
*.flac    filter=lfs diff=lfs merge=lfs -text

# Video
*.mp4     filter=lfs diff=lfs merge=lfs -text
*.mov     filter=lfs diff=lfs merge=lfs -text
*.webm    filter=lfs diff=lfs merge=lfs -text

# Schriften
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text

# Substance, Plugins, Archive
*.spp     filter=lfs diff=lfs merge=lfs -text
*.sbsar   filter=lfs diff=lfs merge=lfs -text
*.dll     filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text
*.7z      filter=lfs diff=lfs merge=lfs -text

# Gebackene Lichtdaten (binär, können groß werden)
*.bytes             filter=lfs diff=lfs merge=lfs -text
LightingData.asset  filter=lfs diff=lfs merge=lfs -text

# Gelände-Höhenkarten (TerrainData speichert Unity binär, trotz *.asset oben als Text)
Assets/_Project/Art/Terrain/Berg.asset  filter=lfs diff=lfs merge=lfs -text

# ─── Claude Code Game Studios: Skripte brauchen LF, sonst bricht Bash unter Windows ───
*.sh   text eol=lf
*.awk  text eol=lf
*.tsv  text eol=lf
.claude/**/*.md  text eol=lf
